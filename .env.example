# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key (console.anthropic.com) - powers the discovery + enrichment agents
ANTHROPIC_API_KEY=

# Shared secret required in the x-cron-secret header to trigger /api/discover and
# /api/enrich from a scheduler (Vercel Cron, n8n, etc). Generate any random string.
CRON_SECRET=

# Same Bearer secret used by Command Center / Battlecard Generator to call
# POST /api/ingest/client-documents on the Iris sales app. Server-side only —
# never expose to the browser. Get the value from whoever manages that secret.
BC_INGEST_SECRET=

# Base URL of the Iris sales app's ingest endpoint. Defaults to production if unset.
IRIS_INGEST_URL=https://icon-sales-app.vercel.app/api/ingest/client-documents

# Stripe (Dashboard → Developers → API keys / Products)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_CHECKOUT_ENABLED=false
STRIPE_ALLOW_LIVE_CHECKOUT=false


# Annual recurring Prices (test mode). Optional — billing UI hides Annual until all three are set.
# Amounts must be 10× monthly: Starter $790, Growth $1990, Scale $4990 per year.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=

# Admin: flag members when cycle AI spend ≥ this share of monthly plan price (default 0.55).
# ADMIN_MARGIN_RISK_RATIO=0.55

# HMAC secret for owner "Login as" sessions. Generate any long random string.
IMPERSONATION_SECRET=

# Resend (shared Project ICON account; use a dedicated API key for Event Scout)
# Verified sending domain: mail.projecticon.io
RESEND_API_KEY=
RESEND_FROM="Event Scout <support@mail.projecticon.io>"
RESEND_REPLY_TO=admin@projecticon.io
RESEND_OWNER_EMAIL=admin@projecticon.io
# Optional: absolute logo URL for email clients (needed when APP_URL is localhost)
# RESEND_LOGO_URL=https://your-production-host/brand/icon-mark-square.png
